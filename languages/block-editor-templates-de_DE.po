#: src/admin/class-admin.php:1257 src/admin/assets/src/default-content-panel.js:50
msgid "When enabled, new posts of this post type start with this template’s blocks and the content entered in them. When disabled, new posts get only the empty block structure. Only applies when creating a post in the WordPress admin."
msgstr "Wenn aktiviert, starten neue Beiträge dieses Inhaltstyps mit den Blöcken dieser Vorlage und den darin eingegebenen Inhalten. Wenn deaktiviert, erhalten neue Beiträge nur die leere Blockstruktur. Gilt nur beim Erstellen eines Beitrags im WordPress-Adminbereich."

#: src/admin/class-admin.php:1263
msgid "Prefill new posts"
msgstr "Neue Beiträge vorausfüllen"

#: src/admin/class-admin.php:1289
msgid "Prefill enabled"
msgstr "Vorausfüllen aktiviert"

#: src/admin/class-admin.php:1291
msgid "Prefill disabled"
msgstr "Vorausfüllen deaktiviert"

#: src/admin/assets/src/abet-filters.js:240
msgid "Placeholder options"
msgstr "Platzhalter-Optionen"

#. translators: 1: placeholder attribute name, 2: expected base attribute name.
#: src/admin/assets/src/abet-filters.js:257
#, js-format
msgid "“%1$s” is set, but its matching attribute “%2$s” does not exist on this block, so it cannot be used as a placeholder."
msgstr "„%1$s“ ist gesetzt, aber das zugehörige Attribut „%2$s“ existiert in diesem Block nicht und kann daher nicht als Platzhalter verwendet werden."

#. translators: 1: suggested placeholder attribute name (e.g. "contentPlaceholder"), 2: existing base attribute name (e.g. "content").
#: src/admin/assets/src/abet-filters.js:267
#, js-format
msgid "Did you mean “%1$s”? This block has a matching “%2$s” attribute."
msgstr "Meintest du „%1$s“? Dieser Block hat ein passendes Attribut „%2$s“."

#. translators: %s: comma-separated list of suggested placeholder attribute names.
#: src/admin/assets/src/abet-filters.js:278
#, js-format
msgid "Did you perhaps mean one of: %s?"
msgstr "Meintest du vielleicht eines von: %s?"

#. translators: 1: placeholder attribute name, 2: placeholder data-type, 3: base attribute name, 4: base data-type.
#: src/admin/assets/src/abet-filters.js:305
#, js-format
msgid "Type mismatch: “%1$s” (%2$s) must be the same data-type as “%3$s” (%4$s)."
msgstr "Typkonflikt: „%1$s“ (%2$s) muss denselben Datentyp haben wie „%3$s“ (%4$s)."

#: src/admin/assets/src/abet-filters.js:325
msgid "Use content as placeholder"
msgstr "Inhalt als Platzhalter verwenden"

#: src/admin/assets/src/abet-filters.js:331
msgid "Inherited from a parent block: this block’s content is already used as placeholder text."
msgstr "Von einem übergeordneten Block geerbt: Der Inhalt dieses Blocks wird bereits als Platzhaltertext verwendet."

#: src/admin/assets/src/abet-filters.js:335
msgid "When on, the text you typed is moved into this block’s placeholder attribute and shown as a greyed-out hint. New posts created from this template start with that hint instead of real content. Turn it off to move the text back."
msgstr "Wenn aktiviert, wird der eingegebene Text in das Platzhalter-Attribut dieses Blocks verschoben und als ausgegrauter Hinweis angezeigt. Neue Beiträge, die aus dieser Vorlage erstellt werden, starten mit diesem Hinweis statt mit echtem Inhalt. Deaktiviere die Option, um den Text zurückzuverschieben."

#: src/admin/assets/src/abet-filters.js:347
msgid "This block has no valid placeholder attributes to toggle."
msgstr "Dieser Block hat keine gültigen Platzhalter-Attribute zum Umschalten."

#: src/admin/assets/src/abet-filters.js:410
msgid "Used as placeholder"
msgstr "Als Platzhalter verwendet"

