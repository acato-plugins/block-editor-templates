#. translators: %d: number of templates moved to the trash.
#: src/admin/class-admin.php:558
#, php-format
msgid "%d template moved to the trash."
msgid_plural "%d templates moved to the trash."
msgstr[0] "%d modèle déplacé dans la corbeille."
msgstr[1] "%d modèles déplacés dans la corbeille."

#: src/admin/class-admin.php:577
msgid "These Post Type Templates exist for post types that no longer use the block editor. You can move them to the trash:"
msgstr "Ces modèles de type de publication existent pour des types de publication qui n’utilisent plus l’éditeur de blocs. Vous pouvez les déplacer dans la corbeille :"

#: src/admin/class-admin.php:590
msgid "Move all to Trash"
msgstr "Tout déplacer dans la corbeille"

#. translators: %s: template title.
#: src/admin/class-admin.php:603
#, php-format
msgid "The Post Type Template “%s” exists for a post type that no longer uses the block editor."
msgstr "Le modèle de type de publication « %s » existe pour un type de publication qui n’utilise plus l’éditeur de blocs."

