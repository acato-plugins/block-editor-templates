#: src/admin/class-admin.php:1215
#: src/admin/assets/src/default-content-panel.js:44
msgid "Copy this template into new posts (keeping heading and paragraph text). Only applies when creating a post in the WordPress admin."
msgstr "Kopieer dit sjabloon naar nieuwe berichten (met behoud van kop- en alineatekst). Alleen van toepassing bij het aanmaken van een bericht in het WordPress-beheer."

#: src/admin/class-admin.php:1221
msgid "Prefill new posts"
msgstr "Nieuwe berichten voorinvullen"

#: src/admin/class-admin.php:1247
msgid "Prefill enabled"
msgstr "Voorinvullen ingeschakeld"

#: src/admin/class-admin.php:1249
msgid "Prefill disabled"
msgstr "Voorinvullen uitgeschakeld"

#. translators: 1: placeholder attribute name, 2: expected base attribute name.
#: src/admin/assets/src/abet-filters.js:234
#, js-format
msgid "“%1$s” is set, but its matching attribute “%2$s” does not exist on this block, so it cannot be used as a placeholder."
msgstr "“%1$s” is ingesteld, maar het bijbehorende attribuut “%2$s” bestaat niet op dit blok, dus het kan niet als placeholder worden gebruikt."

#. translators: 1: suggested placeholder attribute name (e.g. "contentPlaceholder"), 2: existing base attribute name (e.g. "content").
#: src/admin/assets/src/abet-filters.js:244
#, js-format
msgid "Did you mean “%1$s”? This block has a matching “%2$s” attribute."
msgstr "Bedoelde je “%1$s”? Dit blok heeft een bijbehorend attribuut “%2$s”."

#. translators: %s: comma-separated list of suggested placeholder attribute names.
#: src/admin/assets/src/abet-filters.js:255
#, js-format
msgid "Did you perhaps mean one of: %s?"
msgstr "Bedoelde je misschien een van: %s?"

#. translators: 1: placeholder attribute name, 2: placeholder data-type, 3: base attribute name, 4: base data-type.
#: src/admin/assets/src/abet-filters.js:282
#, js-format
msgid "Type mismatch: “%1$s” (%2$s) must be the same data-type as “%3$s” (%4$s)."
msgstr "Type komt niet overeen: “%1$s” (%2$s) moet hetzelfde datatype zijn als “%3$s” (%4$s)."

#: src/admin/assets/src/abet-filters.js:302
msgid "Use content as placeholder"
msgstr "Inhoud als placeholder gebruiken"

#: src/admin/assets/src/abet-filters.js:308
msgid "Inherited from a parent block: this block’s content is already used as placeholder text."
msgstr "Overgenomen van een bovenliggend blok: de inhoud van dit blok wordt al als placeholdertekst gebruikt."

#: src/admin/assets/src/abet-filters.js:312
msgid "When on, this block’s content is stored as placeholder text. New posts created from this template start with it as an editable hint instead of real content."
msgstr "Wanneer ingeschakeld, wordt de inhoud van dit blok opgeslagen als placeholdertekst. Nieuwe berichten die met dit sjabloon worden aangemaakt, beginnen hiermee als bewerkbare hint in plaats van echte inhoud."

#: src/admin/assets/src/abet-filters.js:328
msgid "This block has no valid placeholder attributes to toggle."
msgstr "Dit blok heeft geen geldige placeholder-attributen om te wisselen."

#: src/admin/assets/src/abet-filters.js:391
msgid "Used as placeholder"
msgstr "Gebruikt als placeholder"

#: src/admin/assets/src/default-content-panel.js:40
msgid "Post Type Template"
msgstr "Berichttype-sjabloon"

#: src/admin/assets/src/default-content-panel.js:43
msgid "Prefill new posts with this template"
msgstr "Nieuwe berichten voorinvullen met dit sjabloon"
